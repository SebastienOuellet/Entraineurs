# Serveur
NODE_ENV=development
PORT=5030
APP_NAME=Entraîneurs
PUBLIC_BASE_URL=http://localhost:4200
TIMEZONE=America/Toronto
LOG_LEVEL=debug

# Base de donnees PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=entraineurs
DB_USER=
DB_PW=
# true (defaut) pour un Postgres gere (DigitalOcean) ; false pour un Postgres local
DB_SSL=false
# Base utilisee par les tests d'integration (npm test). Son nom doit finir par _test.
# Laisser vide pour les sauter.
TEST_DB_NAME=

# Firebase (authentification) : nom du fichier JSON depose dans backend/firebaseConfig/
FIREBASE_CREDENTIAL_FILE=

# Courriel (SMTP). SMTP_SECURE=true seulement pour le port 465 ; false = STARTTLS (587 / 2525).
# Sans SMTP_HOST, aucun courriel ne part : ils sont seulement journalises.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true = aucun courriel reel meme si SMTP est configure (developpement)
EMAIL_DRY_RUN=false
